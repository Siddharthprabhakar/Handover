# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API). The service-role key is a master key: server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Model API (server only). MUSE_MOCK=1 uses built-in stand-ins instead of the real model.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_MOCK=1

# Gmail SMTP (Google Account -> Security -> App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# App
APP_URL=http://localhost:3000
CRON_SECRET=
