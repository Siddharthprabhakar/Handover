# Copy to .env.local. Never commit real keys.

# Meta Model API (server side only)
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1
# 1 = return saved sample answers instead of calling Muse
MUSE_MOCK=1

# Supabase (leave empty to run on in-memory seed data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email and reminders (later stages)
RESEND_API_KEY=
CRON_SECRET=

# Email (stage 8). Seeded people have made-up addresses, so real delivery needs DEMO_EMAIL_TO:
# every message is redirected there. Without it, mail only appears at /outbox.
APP_URL=http://localhost:3000
DEMO_EMAIL_TO=
RESEND_FROM=Handover <onboarding@resend.dev>
